@{
    ViewData["Title"] = "Patient Home";
}

<div class="container mt-5">
    <h2>Welcome, @Context.Session.GetString("UserFullName")!</h2>
    <p class="lead">This is your patient dashboard.</p>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Find Providers</h5>
                    <p class="card-text">Search and book appointments with healthcare providers.</p>
                    <a asp-action="SearchProviders" class="btn btn-primary">Search</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">My Appointments</h5>
                    <p class="card-text">View and manage your upcoming appointments.</p>
                    <a asp-action="ViewMyAppointments" asp-route-patientId="1" class="btn btn-primary">View</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">My Profile</h5>
                    <p class="card-text">Update your personal information.</p>
                    <a asp-action="ViewProfile" class="btn btn-primary">View Profile</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Logout" class="btn btn-outline-danger">Logout</a>
    </div>
</div>
